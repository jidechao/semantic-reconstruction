include LICENSE
include README.md
recursive-include src/semantic_reconstruction *.py
recursive-include docs *.md
recursive-include examples *.py
prune .venv
prune output
prune output-hybrid
prune output-llm
exclude .env
global-exclude .env
global-exclude *.pyc
global-exclude __pycache__
prune tests
prune data
prune _legacy_semantic_reconstruction
